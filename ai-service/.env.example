# Camera Configuration
# CCTV HTTP camera stream URL (default for development/testing)
CAMERA_URL=http://YOUR_CAMERA_IP:8080/video
CAMERA_KEY=CAM-XXXXXXXX

# ImgBB API credentials (Get a free key from https://api.imgbb.com/)
IMGBB_API_KEY=YOUR_IMGBB_API_KEY

# Integration Endpoints
NEXTJS_ALERT_API=http://localhost:3000/api/alerts
ALERT_COOLDOWN=10

# AI Model Configuration
# Pretrained YOLOv8 model file name (placed in root or downloaded automatically)
YOLO_MODEL=yolov8n.pt
CONFIDENCE_THRESHOLD=0.5

# Display Options (Set to false for headless server runs)
DISPLAY_WINDOW=true

# Adaptive Inference Optimization Parameters
MOTION_GATE_ENABLED=true
MOTION_THRESHOLD=0.15
LOW_PRIORITY_FPS=2.0
NORMAL_PRIORITY_FPS=5.0
HIGH_PRIORITY_FPS=10.0
CRITICAL_PRIORITY_FPS=15.0
MAX_INFERENCE_INTERVAL_SECONDS=5.0
MIN_ACTIVE_SECURITY_FPS=2.0
IDENTITY_RECHECK_SECONDS=30.0
PRIORITY_MIN_DURATION_SECONDS=2.0
PRIORITY_COOLDOWN_SECONDS=10.0
ACTIVE_TRACK_HIGH_THRESHOLD=5
ZONE_PROXIMITY_THRESHOLD=0.08
UNKNOWN_PERSON_PRIORITY=HIGH
RESTRICTED_ZONE_PRIORITY=HIGH
VALUABLE_ZONE_PRIORITY=HIGH
CASH_COUNTER_ZONE_PRIORITY=MEDIUM

