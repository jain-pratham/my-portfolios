# Camera Configuration
# CCTV HTTP camera stream URL (default for development/testing)
CAMERA_URL=http://YOUR_CAMERA_IP:8080/video
CAMERA_KEY=CAM-XXXXXXXX

# ImgBB API credentials (Get a free key from https://api.imgbb.com/)
IMGBB_API_KEY=YOUR_IMGBB_API_KEY

# Integration Endpoints
NEXTJS_ALERT_API=http://localhost:3000/api/alerts
ALERT_COOLDOWN=10

# AI Model Configuration
# Pretrained YOLOv8 model file name (placed in root or downloaded automatically)
YOLO_MODEL=yolov8n.pt
CONFIDENCE_THRESHOLD=0.5

# Display Options (Set to false for headless server runs)
DISPLAY_WINDOW=true
