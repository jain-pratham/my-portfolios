---
interface SectionItem {
  title: string;
  description: string;
}

interface TechCategory {
  category: string;
  items: string[];
}

interface CtaConfig {
  title: string;
  subtitle: string;
  primaryLabel: string;
  secondaryLabel: string;
  primaryHref?: string;
  secondaryHref?: string;
}

interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  overview: string;
  highlights: string[];
  process: SectionItem[];
  outcomes: SectionItem[];
  architecture: SectionItem[];
  techStack: TechCategory[];
  useCases?: SectionItem[];
  capabilities?: string[];
  engagementModels?: SectionItem[];
  cta?: CtaConfig;
  breadcrumbs?: string[];
}

const {
  title,
  subtitle,
  overview,
  highlights,
  process,
  outcomes,
  architecture,
  techStack,
  useCases = [],
  capabilities = [],
  engagementModels = [],
  breadcrumbs,
  cta = {
    title: 'Ready to Build Something Scalable?',
    subtitle: 'Discuss your requirements and get a clear execution roadmap.',
    primaryLabel: 'Start Your Project',
    secondaryLabel: 'Contact Us',
    primaryHref: '#contact',
    secondaryHref: '#contact'
  }
} = Astro.props as Props;

const categoryIconTone: Record<string, string> = {
  Frontend: 'from-sky-500 to-cyan-500',
  'Frontend / Mobile': 'from-indigo-500 to-sky-500',
  Backend: 'from-emerald-500 to-teal-500',
  Database: 'from-violet-500 to-indigo-500',
  'DevOps & Deployment': 'from-orange-500 to-amber-500',
  Deployment: 'from-rose-500 to-orange-500',
  Platform: 'from-fuchsia-500 to-purple-500',
  Payments: 'from-lime-500 to-emerald-500',
  Architecture: 'from-blue-500 to-indigo-500',
  DevOps: 'from-amber-500 to-yellow-500',
  'Cloud Platforms': 'from-cyan-500 to-blue-500',
  Containerization: 'from-teal-500 to-cyan-500',
  'CI/CD': 'from-slate-500 to-gray-700',
  Monitoring: 'from-pink-500 to-rose-500',
  Networking: 'from-sky-500 to-indigo-500'
};

const techIconSlug: Record<string, string> = {
  React: 'react',
  'Next.js': 'nextdotjs',
  Svelte: 'svelte',
  Vue: 'vuedotjs',
  'Tailwind CSS': 'tailwindcss',
  TypeScript: 'typescript',
  'Node.js': 'nodedotjs',
  Express: 'express',
  NestJS: 'nestjs',
  MongoDB: 'mongodb',
  PostgreSQL: 'postgresql',
  Redis: 'redis',
  Vercel: 'vercel',
  AWS: 'amazonwebservices',
  Docker: 'docker',
  Nginx: 'nginx',
  Flutter: 'flutter',
  'React Native': 'react',
  Kotlin: 'kotlin',
  Swift: 'swift',
  Firebase: 'firebase',
  'Firebase Firestore': 'firebase',
  'Google Play Console': 'googleplay',
  'App Store': 'appstore',
  'CI/CD': 'githubactions',
  Shopify: 'shopify',
  WooCommerce: 'woocommerce',
  Stripe: 'stripe',
  Razorpay: 'razorpay',
  'REST APIs': 'openapiinitiative',
  Microservices: 'kubernetes',
  Kubernetes: 'kubernetes',
  'GitHub Actions': 'githubactions',
  'CI/CD Pipelines': 'githubactions',
  CloudWatch: 'amazoncloudwatch',
  'Logging Systems': 'elastic',
  'Load Balancers': 'nginx'
};

const toneFor = (category: string) => categoryIconTone[category] ?? 'from-slate-500 to-slate-700';

const techMonogram = (name: string) => {
  const words = name.split(/\s+/).filter(Boolean);
  if (words.length === 1) {
    return words[0].slice(0, 2).toUpperCase();
  }
  return (words[0][0] + words[1][0]).toUpperCase();
};

const techIconUrl = (name: string) => {
  const slug = techIconSlug[name];
  if (!slug) return null;
  return `https://cdn.simpleicons.org/${slug}`;
};

const heroHighlights = highlights.slice(0, 4);
const deliveryItems = process.slice(0, 4).map((item) => item.title);
const heroBreadcrumbs = breadcrumbs && breadcrumbs.length > 0 ? breadcrumbs : ['Home', 'Services', title];
---

<section class="bg-[#edf3f8] px-4 pb-20 pt-14 sm:px-6 lg:px-10" style="background-image: radial-gradient(circle at 1px 1px, rgba(26, 92, 141, 0.09) 1.3px, transparent 0); background-size: 44px 44px;">
  <div class="mx-auto max-w-[1400px] space-y-8">
    <div class="rounded-[2.25rem] border border-[#d8e4ef] bg-[linear-gradient(90deg,rgba(248,251,255,0.98)_0%,rgba(240,247,253,0.96)_55%,rgba(232,243,251,0.95)_100%)] px-8 py-10 shadow-[0_14px_34px_rgba(22,57,87,0.08)] sm:px-12">
      <div class="grid items-start gap-10 xl:grid-cols-[1.15fr_0.85fr]">
        <div>
          <div class="mb-5 flex flex-wrap items-center gap-2 text-[0.75rem] font-bold uppercase tracking-[0.2em] text-[#8aa0bb] sm:text-xs">
            {heroBreadcrumbs.map((crumb, index) => (
              <>
                <span class={index === heroBreadcrumbs.length - 1 ? "text-[#00a6f4]" : "text-[#8aa0bb]"}>{crumb}</span>
                {index < heroBreadcrumbs.length - 1 && <span class="px-1 text-[#b6c7d8]">/</span>}
              </>
            ))}
          </div>
          <!-- <p class="inline-flex items-center rounded-full border border-[#d5e4f1] bg-[#e8eff6] px-6 py-2 text-xs font-bold uppercase tracking-[0.3em] text-[#00a6f4]">{eyebrow}</p> -->
          <h1 class="mt-5 text-4xl font-black leading-[1.02] tracking-tight text-[#112244] sm:text-5xl lg:text-6xl">{title}</h1>
          <p class="mt-5 max-w-3xl text-xl leading-relaxed text-[#53698a] sm:text-2xl">{subtitle}</p>

          <div class="mt-8 grid gap-y-4 sm:grid-cols-2 sm:gap-x-8">
            {heroHighlights.map((item, index) => (
              <div class="flex items-start gap-3">
  <span class="mt-1.5 inline-block h-2.5 w-2.5 rounded-full bg-[#00a6f4] shadow-[0_0_0_4px_rgba(0,166,244,0.15)]"></span>
  <p class="text-base sm:text-lg font-semibold leading-snug text-[#253a5a]">
    {item}
  </p>
</div>
            ))}
          </div>

          <div class="mt-10 flex flex-wrap items-center gap-5">
            <a href="#contact" class="rounded-2xl bg-[#214f7e] px-10 py-4 text-lg font-bold text-white shadow-[0_10px_24px_rgba(31,78,121,0.28)] transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#1b4268]">Deploy Idea</a>
            <a href="#contact" class="text-2xl font-bold text-[#214f7e] underline decoration-[#c7def2] underline-offset-[10px]">Contact us</a>
          </div>
        </div>

        <aside class="rounded-[2.2rem] border border-[#d7e3ee] bg-[#f7fbff] p-7 shadow-[0_18px_30px_rgba(31,78,121,0.12)]">
          <div class="h-2 w-full rounded-full bg-gradient-to-r from-[#1f4e79] via-[#2e6da5] to-[#0ea5e9]"></div>
          <p class="mt-8 text-sm font-black uppercase tracking-[0.2em] text-[#00a6f4]">What We Deliver</p>
          <ul class="mt-6 space-y-5">
            {deliveryItems.map((item) => (
              <li class="flex items-start gap-3 text-l font-bold text-[#2a3f5f] sm:text-[1.65rem]">
                <span class="mt-1 inline-flex h-9 w-9 items-center justify-center rounded-full bg-[#d9edf9] text-[#00a6f4]">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <div class="mt-8 border-t border-[#e0e9f2] pt-6">
            <div class="grid grid-cols-2 gap-5 text-center">
              <div>
                <p class="text-4xl font-black text-[#0ea5e9]">100%</p>
                <p class="mt-1 text-sm font-bold uppercase tracking-[0.2em] text-[#6c819e]">Code Quality</p>
              </div>
              <div>
                <p class="text-4xl font-black text-[#214f7e]">5.0</p>
                <p class="mt-1 text-sm font-bold uppercase tracking-[0.2em] text-[#6c819e]">Client Rating</p>
              </div>
            </div>
          </div>
        </aside>
      </div>

      <div class="mt-9 rounded-2xl border border-[#dce6f0] bg-[#edf4fb] p-6">
        <h2 class="text-lg font-bold text-[#1f3554]">Service Overview</h2>
        <p class="mt-2 text-[#556b89]">{overview}</p>
      </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-3">
      <div class="rounded-2xl border border-[#dce6f0] bg-[#f2f5f8] p-6 shadow-[0_6px_18px_rgba(15,23,42,0.05)] lg:col-span-1">
        <h2 class="text-lg font-bold text-[#1f3554]">What You Get</h2>
        <ul class="mt-4 space-y-3 text-sm text-[#4f6382] sm:text-[1.04rem]">
          {highlights.map((item) => (
            <li class="flex items-start gap-3 leading-relaxed">
              <span class="mt-[0.62rem] inline-block h-2.5 w-2.5 rounded-full bg-[#00a6f4] shadow-[0_0_0_4px_rgba(0,166,244,0.12)]"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="rounded-2xl border border-[#dce6f0] bg-[#f2f5f8] p-6 shadow-[0_6px_18px_rgba(15,23,42,0.05)] lg:col-span-2">
        <h2 class="text-lg font-bold text-[#1f3554]">How We Deliver</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {process.map((step) => (
            <article class="rounded-xl border border-[#dbe3ed] bg-[#eff3f7] p-4 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-md">
              <h3 class="text-sm font-bold text-[#1f3554]">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-[#556b89]">{step.description}</p>
            </article>
          ))}
        </div>
      </div>
    </div>

    <div class="rounded-2xl border border-[#dce6f0] bg-[#f7f9fc] p-6 shadow-[0_8px_22px_rgba(31,78,121,0.08)]">
      <h2 class="text-lg font-bold text-[#1f3554]">Tech Stack</h2>
      <p class="mt-2 text-sm text-[#556b89]">Proven technologies selected for scalability, performance, and long-term maintainability.</p>

      <div class="mt-5 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {techStack.map((group) => (
          <article class="rounded-2xl border border-[#dce4ee] bg-[#f1f5f9] p-4 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
            <div class="flex items-center gap-3">
              <span class={`inline-flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br ${toneFor(group.category)} text-white shadow-sm`}>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 12l8-4.5"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 12v9"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 12L4 7.5"></path>
                </svg>
              </span>
              <h3 class="text-sm font-bold text-[#1f3554]">{group.category}</h3>
            </div>

            <div class="mt-3 flex flex-wrap gap-2">
              {group.items.map((tech) => (
                <span class="inline-flex items-center gap-2 rounded-full border border-[#d5dfeb] bg-white px-3 py-1 text-xs font-semibold text-[#334a69] shadow-[0_2px_8px_rgba(15,23,42,0.05)]">
                  {techIconUrl(tech) ? (
                    <img src={techIconUrl(tech) ?? ''} alt={`${tech} icon`} class="h-3.5 w-3.5" loading="lazy" decoding="async" />
                  ) : (
                    <span class="inline-flex h-4 w-4 items-center justify-center rounded-full bg-gradient-to-r from-slate-700 to-slate-500 text-[9px] font-bold text-white">{techMonogram(tech)}</span>
                  )}
                  {tech}
                </span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>

    {useCases.length > 0 && (
      <div class="rounded-2xl border border-[#dce6f0] bg-[#f2f5f8] p-6 shadow-[0_6px_18px_rgba(15,23,42,0.05)]">
        <h2 class="text-lg font-bold text-[#1f3554]">Where This Fits</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {useCases.map((item) => (
            <article class="rounded-xl border border-[#dbe3ed] bg-[#eff3f7] p-4">
              <h3 class="text-sm font-bold text-[#1f3554]">{item.title}</h3>
              <p class="mt-2 text-sm text-[#556b89]">{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    )}

    {capabilities.length > 0 && (
      <div class="rounded-2xl border border-[#dce6f0] bg-[#f2f5f8] p-6 shadow-[0_6px_18px_rgba(15,23,42,0.05)]">
        <h2 class="text-lg font-bold text-[#1f3554]">What We've Built & Optimized</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {capabilities.map((item) => (
            <li class="flex items-start gap-3 rounded-xl border border-[#dbe3ed] bg-[#eff3f7] p-3 text-sm font-semibold text-[#2b3f5f]">
              <span class="mt-1 inline-block h-2.5 w-2.5 rounded-full bg-[#00a6f4] shadow-[0_0_0_4px_rgba(0,166,244,0.12)]"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    {engagementModels.length > 0 && (
      <div class="rounded-2xl border border-[#dce6f0] bg-[#f2f5f8] p-6 shadow-[0_6px_18px_rgba(15,23,42,0.05)]">
        <h2 class="text-lg font-bold text-[#1f3554]">Engagement Models</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {engagementModels.map((item) => (
            <article class="rounded-xl border border-[#dbe3ed] bg-[#eff3f7] p-4">
              <h3 class="text-sm font-bold text-[#1f3554]">{item.title}</h3>
              <p class="mt-2 text-sm text-[#556b89]">{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    )}

    <div class="rounded-2xl border border-[#dce6f0] bg-[#f2f5f8] p-6 shadow-[0_6px_18px_rgba(15,23,42,0.05)]">
      <h2 class="text-lg font-bold text-[#1f3554]">Architecture & Engineering Approach</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {architecture.map((item) => (
          <article class="rounded-xl border border-[#dbe3ed] bg-[#eff3f7] p-4 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-md">
            <h3 class="text-sm font-bold text-[#1f3554]">{item.title}</h3>
            <p class="mt-2 text-sm text-[#556b89]">{item.description}</p>
          </article>
        ))}
      </div>
    </div>

    <div class="rounded-2xl border border-[#dce6f0] bg-[#f2f5f8] p-6 shadow-[0_6px_18px_rgba(15,23,42,0.05)]">
      <h2 class="text-lg font-bold text-[#1f3554]">Expected Outcomes</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {outcomes.map((item) => (
          <article class="rounded-xl border border-[#dbe3ed] bg-[#eff3f7] p-4 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-md">
            <h3 class="text-sm font-bold text-[#1f3554]">{item.title}</h3>
            <p class="mt-2 text-sm text-[#556b89]">{item.description}</p>
          </article>
        ))}
      </div>
    </div>

    <div class="rounded-3xl border border-[#20486f]/30 bg-gradient-to-r from-[#1f4e79] to-[#163957] px-6 py-12 text-center shadow-[0_14px_34px_rgba(22,57,87,0.35)] sm:px-10">
      <h2 class="text-3xl font-black tracking-tight text-white sm:text-4xl">{cta.title}</h2>
      <p class="mx-auto mt-3 max-w-2xl text-base text-[#d3e6f8] sm:text-lg">{cta.subtitle}</p>
      <div class="mt-7 flex flex-wrap items-center justify-center gap-4">
        <a href={cta.primaryHref ?? '#contact'} class="rounded-xl bg-white px-6 py-3 text-sm font-bold text-[#1f4e79] transition hover:bg-[#e8f3ff]">{cta.primaryLabel}</a>
        <a href={cta.secondaryHref ?? '#contact'} class="rounded-xl border border-white/40 px-6 py-3 text-sm font-bold text-white transition hover:bg-white/10">{cta.secondaryLabel}</a>
      </div>
    </div>
  </div>
</section>



