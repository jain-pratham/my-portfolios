---
import type { ServiceFeature, ServicePageCta } from '../../data/servicesData';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle: string;
  description: string;
  features: ServiceFeature[];
  benefits: string[];
  image?: string;
  imageAlt?: string;
  cta?: ServicePageCta;
}

const props = Astro.props as Props;

const eyebrow = props.eyebrow ?? 'Services';
const title = props.title;
const subtitle = props.subtitle;
const description = props.description;
const features = props.features;
const benefits = props.benefits;
const image = props.image;
const imageAlt = props.imageAlt ?? `${title} illustration`;
const cta = props.cta;

const primaryCta = cta ?? {
  title: 'Start your project with a clear execution plan',
  description: 'We help you move from idea to production with structured design, development, and delivery.',
  primaryLabel: 'Start Project',
  primaryHref: '/contactus',
  secondaryLabel: 'Talk to Expert',
  secondaryHref: '/contactus'
};
---

<section class="bg-[#f8fafc] pt-28 pb-24 px-6">

  <!-- HERO -->
  <div class="max-w-7xl mx-auto text-center">

    <span class="inline-block mb-4 px-4 py-1 text-xs font-bold tracking-widest uppercase text-[#00c6ff] bg-[#00c6ff]/10 rounded-full">
      {eyebrow}
    </span>

    <h1 class="text-4xl md:text-6xl font-black text-[#1f4e79] leading-tight max-w-4xl mx-auto">
      {title}
    </h1>

    <p class="mt-6 text-lg md:text-xl text-slate-600 max-w-3xl mx-auto">
      {subtitle}
    </p>

    <p class="mt-4 text-base text-slate-500 max-w-2xl mx-auto">
      {description}
    </p>

    <div class="mt-8 flex justify-center gap-4 flex-wrap">
      <a href={primaryCta.primaryHref} class="px-7 py-3 bg-[#00c6ff] text-white rounded-xl font-semibold hover:bg-[#1f4e79] transition">
        {primaryCta.primaryLabel}
      </a>

      <a href={primaryCta.secondaryHref} class="px-7 py-3 border border-slate-300 rounded-xl font-semibold text-slate-700 hover:bg-slate-100 transition">
        {primaryCta.secondaryLabel}
      </a>
    </div>

  </div>

  <!-- TRUST STRIP -->
 <div class="max-w-6xl mx-auto mt-16 grid grid-cols-2 md:grid-cols-4 gap-6 text-center">

  <div class="p-6 bg-white rounded-2xl border border-slate-200">
    <h3 class="text-2xl font-bold text-[#1f4e79]">06+</h3>
    <p class="text-sm text-slate-500">Projects Delivered</p>
  </div>

  <div class="p-6 bg-white rounded-2xl border border-slate-200">
    <h3 class="text-2xl font-bold text-[#1f4e79]">Modern</h3>
    <p class="text-sm text-slate-500">Tech Stack</p>
  </div>

  <div class="p-6 bg-white rounded-2xl border border-slate-200">
    <h3 class="text-2xl font-bold text-[#1f4e79]">Fast</h3>
    <p class="text-sm text-slate-500">Delivery</p>
  </div>

  <div class="p-6 bg-white rounded-2xl border border-slate-200">
    <h3 class="text-2xl font-bold text-[#1f4e79]">04</h3>
    <p class="text-sm text-slate-500">Core Team</p>
  </div>

</div>

  <!-- FEATURES -->
  <div class="max-w-7xl mx-auto mt-24">

    <h2 class="text-3xl font-bold text-[#1f4e79] text-center mb-12">
      What We Deliver
    </h2>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">

      {features.map((feature) => (
        <div class="bg-white p-8 rounded-2xl border border-slate-200 hover:shadow-lg transition">

          <div class="h-12 w-12 flex items-center justify-center bg-[#00c6ff]/10 text-[#00c6ff] rounded-xl font-bold">
            {feature.title.slice(0,2)}
          </div>

          <h3 class="mt-6 text-lg font-bold text-[#1f4e79]">
            {feature.title}
          </h3>

          <p class="mt-3 text-sm text-slate-600 leading-relaxed">
            {feature.description}
          </p>

        </div>
      ))}

    </div>

  </div>

  <!-- BENEFITS -->
  <div class="max-w-6xl mx-auto mt-24">

    <h2 class="text-3xl font-bold text-[#1f4e79] text-center mb-12">
      Why Choose Us
    </h2>

    <div class="grid md:grid-cols-2 gap-6">

      {benefits.map((item) => (
        <div class="flex gap-4 bg-white p-6 rounded-2xl border border-slate-200">

          <div class="h-8 w-8 flex items-center justify-center rounded-full bg-[#00c6ff]/10 text-[#00c6ff]">
            <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3.5 8.2 6.5 11l6-6.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>

          <p class="text-slate-600 text-sm leading-relaxed">
            {item}
          </p>

        </div>
      ))}

    </div>

  </div>

  <!-- CTA -->
  <div class="max-w-6xl mx-auto mt-24 bg-gradient-to-r from-[#00c6ff] to-[#1f4e79] rounded-3xl p-12 text-center text-white">

    <h2 class="text-3xl font-bold">
      {primaryCta.title}
    </h2>

    <p class="mt-4 text-white/80 max-w-xl mx-auto">
      {primaryCta.description}
    </p>

    <div class="mt-8 flex justify-center gap-4 flex-wrap">
      <a href={primaryCta.primaryHref} class="px-8 py-3 bg-white text-[#1f4e79] rounded-xl font-semibold">
        {primaryCta.primaryLabel}
      </a>

      <a href={primaryCta.secondaryHref} class="px-8 py-3 border border-white/40 rounded-xl font-semibold">
        {primaryCta.secondaryLabel}
      </a>
    </div>

  </div>

</section>
