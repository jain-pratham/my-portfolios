---
import type { ProductFeature, ProductPageCta } from '../../data/productsData';

interface Props {
  eyebrow?: string;
  name: string;
  image?: string;
  category: string;
  summary: string;
  description: string;
  problemStatement?: string; // NEW: The heading for the problem section
  problemsSolved?: string[]; // NEW: Array of problems this product solves
  highlights: string[];
  modules: ProductFeature[];
  outcomes: string[];
  audience: string[];
  cta?: ProductPageCta;
}

const {
  eyebrow = 'Products',
  name,
  category,
  summary,
  image,
  description,
  problemStatement = 'The Challenges We Solve',
  problemsSolved = [
    "Manual processes are eating up hundreds of hours of your team's time every month.",
    "Data silos make it impossible to get a clear, real-time view of your operations.",
    "Scaling your current workflow requires hiring more headcount instead of leveraging technology."
  ], // Fallback data so it renders beautifully immediately
  highlights,
  modules,
  outcomes,
  audience,
  cta
} = Astro.props as Props;

const primaryCta = cta ?? {
  title: 'Ready to elevate your workflow?',
  description: 'Let us show you how this product can be customized for your team.',
  primaryLabel: 'Book a Demo',
  primaryHref: '#inquire',
  secondaryLabel: 'Contact Sales',
  secondaryHref: '/contactus'
};
---

<div class="bg-white text-slate-900 font-sans selection:bg-[#00c6ff]/20 selection:text-[#1f4e79]">
  
  <section class="relative pt-24 pb-16 sm:pt-32 sm:pb-24 lg:pb-32">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-2 lg:gap-16 lg:items-center">
        
        <div class="max-w-2xl">
          <div class="flex items-center gap-3 mb-6">
            <span class="inline-flex items-center rounded-full bg-[#00c6ff]/10 px-3 py-1 text-xs font-medium text-[#1f4e79] ring-1 ring-[#00c6ff]/20 uppercase tracking-wider">{eyebrow}</span>
            <span class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-600 ring-1 ring-slate-500/20 uppercase tracking-wider">{category}</span>
          </div>
          
          <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl mb-6">{name}</h1>
          <p class="text-xl leading-8 text-slate-600 mb-8">{summary}</p>

          <div class="flex flex-wrap gap-2 mb-10">
            {highlights.map((item) => (
              <span class="inline-flex items-center gap-x-1.5 rounded-md px-3 py-1.5 text-sm font-medium text-slate-700 bg-slate-50 border border-slate-200">
                <svg class="h-1.5 w-1.5 fill-[#00c6ff]" viewBox="0 0 6 6"><circle cx="3" cy="3" r="3" /></svg>
                {item}
              </span>
            ))}
          </div>

          <div class="flex flex-col sm:flex-row gap-4">
            <a href={primaryCta.primaryHref} class="inline-flex justify-center items-center rounded-lg bg-[#1f4e79] px-8 py-3.5 text-base font-semibold text-white shadow-sm hover:bg-[#00c6ff] hover:text-[#0f172a] transition-all">{primaryCta.primaryLabel}</a>
            <a href={primaryCta.secondaryHref} class="inline-flex justify-center items-center rounded-lg bg-white px-8 py-3.5 text-base font-semibold text-slate-900 shadow-sm ring-1 ring-slate-300 hover:bg-slate-50 transition-all">{primaryCta.secondaryLabel}</a>
          </div>
        </div>

        <div class="mt-16 lg:mt-0 relative group">
  
  <div class="relative w-full aspect-[16/10] bg-slate-100 rounded-3xl overflow-hidden flex items-center justify-center">
    
    <img 
      src={image} 
      alt={`${name} product interface`} 
      class="max-h-full max-w-full object-contain transition duration-500 group-hover:scale-105"
      loading="eager"
    />

    <!-- border -->
    <div class="absolute inset-0 ring-1 ring-inset ring-black/10 rounded-3xl"></div>

  </div>

</div>

      </div>
    </div>
  </section>

  <section class="py-16 bg-slate-50 border-y border-slate-200">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 mb-6">About the Product</h2>
      <p class="text-lg leading-relaxed text-slate-600">
        {description}
      </p>
    </div>
  </section>

  {problemsSolved && problemsSolved.length > 0 && (
    <section class="py-20 bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center mb-14">
          <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{problemStatement}</h2>
          <p class="mt-4 text-lg text-slate-600">Don't let these roadblocks slow down your organization.</p>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {problemsSolved.map((problem) => (
            <div class="flex items-start gap-4 p-6 rounded-2xl bg-[#f8fafc] border border-slate-200 shadow-sm">
              <div class="flex-none rounded-full bg-[#00c6ff]/10 p-1.5 mt-0.5">
                <svg class="h-5 w-5 text-[#1f4e79]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
              </div>
              <p class="text-slate-700 leading-relaxed font-medium">{problem}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="py-24 bg-slate-50 border-t border-slate-200">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-16 max-w-2xl">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Core Modules & Features</h2>
        <p class="mt-4 text-lg text-slate-600">The tools you need to overcome those challenges and drive growth.</p>
      </div>

      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {modules.map((feature, index) => (
          <div class="relative pl-16 p-6 rounded-2xl border border-slate-200 hover:border-[#00c6ff]/30 hover:shadow-lg transition-all bg-white group">
            <div class="absolute left-6 top-6 flex h-10 w-10 items-center justify-center rounded-lg bg-[#1f4e79] group-hover:bg-[#00c6ff] transition-colors">
              <span class="text-white font-bold text-sm">0{index + 1}</span>
            </div>
            <h3 class="text-lg font-semibold leading-7 text-slate-900">
              {feature.title}
            </h3>
            <p class="mt-2 text-base leading-7 text-slate-600">
              {feature.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 bg-slate-900 text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16">
        
        <div>
          <h2 class="text-3xl font-bold tracking-tight mb-8">Who is this for?</h2>
          <ul class="space-y-4">
            {audience.map((item) => (
              <li class="flex items-start gap-4 p-4 rounded-xl bg-white/5 border border-white/10">
                <svg class="h-6 w-6 flex-none text-[#00c6ff]" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span class="text-slate-300 leading-6">{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h2 class="text-3xl font-bold tracking-tight mb-8">Business Outcomes</h2>
          <div class="grid sm:grid-cols-2 gap-4">
            {outcomes.map((item) => (
              <div class="p-6 rounded-xl bg-[#1f4e79]/10 border border-[#00c6ff]/20">
                <p class="text-cyan-50 font-medium leading-6">{item}</p>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  <section id="inquire" class="py-24 bg-white relative overflow-hidden">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="bg-white rounded-3xl shadow-xl border border-slate-200 p-8 sm:p-12">
        <div class="text-center mb-10">
          <h2 class="text-3xl font-bold tracking-tight text-slate-900 mb-4">{primaryCta.title}</h2>
          <p class="text-lg text-slate-600">{primaryCta.description}</p>
        </div>

        <form action="#" method="POST" class="space-y-6">
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <div>
              <label for="first-name" class="block text-sm font-medium leading-6 text-slate-900">First name</label>
              <div class="mt-2">
                <input type="text" name="first-name" id="first-name" class="block w-full rounded-md border-0 py-2.5 px-3.5 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-[#00c6ff] sm:text-sm sm:leading-6">
              </div>
            </div>
            <div>
              <label for="last-name" class="block text-sm font-medium leading-6 text-slate-900">Last name</label>
              <div class="mt-2">
                <input type="text" name="last-name" id="last-name" class="block w-full rounded-md border-0 py-2.5 px-3.5 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-[#00c6ff] sm:text-sm sm:leading-6">
              </div>
            </div>
          </div>

          <div>
            <label for="email" class="block text-sm font-medium leading-6 text-slate-900">Work Email</label>
            <div class="mt-2">
              <input type="email" name="email" id="email" class="block w-full rounded-md border-0 py-2.5 px-3.5 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-[#00c6ff] sm:text-sm sm:leading-6">
            </div>
          </div>

          <div>
            <label for="message" class="block text-sm font-medium leading-6 text-slate-900">How can we help you with {name}?</label>
            <div class="mt-2">
              <textarea id="message" name="message" rows="4" class="block w-full rounded-md border-0 py-2.5 px-3.5 text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-[#00c6ff] sm:text-sm sm:leading-6"></textarea>
            </div>
          </div>

          <button type="submit" class="block w-full rounded-lg bg-[#1f4e79] px-3.5 py-4 text-center text-sm font-semibold text-white shadow-sm hover:bg-[#00c6ff] hover:text-[#0f172a] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#00c6ff] transition-colors">
            Submit Inquiry
          </button>
        </form>
      </div>
    </div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 -z-10 blur-3xl opacity-30" aria-hidden="true">
      <div class="aspect-[1155/678] w-[72.1875rem] bg-gradient-to-tr from-[#1f4e79] to-[#00c6ff]" style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"></div>
    </div>
  </section>

</div>
